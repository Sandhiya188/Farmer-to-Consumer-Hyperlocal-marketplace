# FarmConnect Environment Configuration
# Copy this file to .env and fill in your actual credentials.

# Django Security
SECRET_KEY=your-secret-key-here
DEBUG=True

# Twilio SMS OTP Gateway Configuration
# Sign up at https://www.twilio.com/ to get your Account SID and Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OTP Security Limits (Optional customizations)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
